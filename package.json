{
  "name": "sora",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build && unocss && concurrently -k -n vite,uno,server -c blue,magenta,green \"vite dev\" \"unocss --watch\" \"wrangler dev --live-reload\"",
    "build": "vite build && unocss && node scripts/stamp-sw.mjs",
    "deploy": "vite build && unocss && node scripts/stamp-sw.mjs && wrangler deploy",
    "watch": "concurrently -k -n vite,uno -c blue,magenta \"vite build --watch\" \"unocss --watch\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@barefootjs/client": "^0.31.1",
    "@barefootjs/hono": "^0.31.1",
    "@barefootjs/jsx": "^0.31.1",
    "@barefootjs/router": "^0.31.1",
    "@barefootjs/shared": "^0.31.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@barefootjs/cli": "^0.31.1",
    "@barefootjs/test": "^0.31.1",
    "@barefootjs/vite": "^0.31.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@unocss/cli": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "concurrently": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.0",
    "unocss": "^66.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
