{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sora",
  "main": "server.tsx",
  "compatibility_date": "2025-01-01",
  // Serve the deployed Worker from the production custom domain. Cloudflare
  // provisions/attaches the hostname (and its certificate) on deploy; the
  // zone for piconic.ai must be on this Cloudflare account for it to bind.
  "routes": [{ "pattern": "sora.piconic.ai", "custom_domain": true }],
  "workers_dev": false,
  // preview_urls defaults to workers_dev (false here), so it needs to be
  // opted back in explicitly — otherwise a non-production-branch build
  // (Cloudflare Workers Builds, "Builds for non-production branches") or a
  // `wrangler versions upload` never gets a *.workers.dev URL to view at all.
  "preview_urls": true,
  // Static assets (CSS, generated client JS, manifest) are served
  // directly by Workers Assets. The Worker script handles everything
  // else — SSR, API routes, etc.
  "assets": {
    "directory": "./public"
  }
}
